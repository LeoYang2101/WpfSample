<Window x:Class="WpfSample.WpfMqttServerice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSample.WpfMqttServerice"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="LogTextBox" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                 Margin="10" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
        <Button x:Name="StopButton" Content="停止服务器" HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" Margin="10" Width="100" Click="StopButton_Click" />
    </Grid>
</Window>
